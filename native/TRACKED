# One path per line, relative to the repo root. Blank lines and # comments ignored.
#
# Only files GENERATED INTO THE APP belong here. The iOS renderer
# (MobRootView.swift, mob_nif.m) lives inside the mob hex package at deps/mob/ios/
# and is NOT app-owned — changing it means forking the dependency or sending an
# upstream patch, which is a different mechanic entirely. See native/README.md.
