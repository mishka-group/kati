# Machine-local absolute paths, written by `mix mob.install`.
mob.exs
android/local.properties

# ── Android build output ────────────────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/app/src/main/jni/.zig-cache/
android/app/src/main/jniLibs/
zig-out/
*.apk
*.aab
*.keystore

# ── iOS build output ────────────────────────────────────────────────────
ios/build/
ios/DerivedData/
*.xcuserstate

# ── macOS ───────────────────────────────────────────────────────────────
.DS_Store

# Left behind by `mix mob.release --android`, which stages the OTP tree here
# for gradle to bundle. Every later DEBUG apk then bakes in that 43MB
# snapshot, and MobBridge.extractOtpIfNeeded unpacks it over <filesDir>/otp
# on the next clean install — silently replacing freshly deployed BEAMs with
# whatever was compiled at release time. bin/deploy_native.sh deletes it.
android/app/src/main/assets/otp.zip
