<?xml version="1.0" encoding="utf-8"?>
<!-- Kati's own file, not generated by mob_new.

     Sizes, and why each is what it is. KatiContinueWidget lays out for three
     (SizeMode.Responsive): COMPACT 110x40dp is the title alone, ROW 180x60dp
     puts the poster beside the title and the second line, TALL 180x110dp lets
     the title wrap to two lines. So:

       minWidth/minHeight        the ROW layout, which is what a fresh drop
                                 shows (3x1 on the 5x5 grid, per targetCell*)
       minResizeWidth/Height     COMPACT: below it there is no room for even
                                 the title
       maxResizeWidth/Height     API 31+; a poster and two lines of text have
                                 nothing to fill a whole screen with, and a
                                 widget stretched past this is mostly padding

     Older launchers ignore targetCell* and maxResize* and use the dp values. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="220dp"
    android:updatePeriodMillis="1800000"
    android:previewImage="@drawable/kati_mark"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/kati_continue_widget_description" />
