    <!-- KATI-END(K-12 supports-rtl) -->
    <!-- KATI-BEGIN(K-32 agp9-extract-native-libs) mob_new=0.4.20
         Dropped: android:extractNativeLibs="true"
         AGP 9 fails packageDebug outright if this is set in the manifest and
